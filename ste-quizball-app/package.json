{
  "name": "ste-quizball-app",
  "version": "1.0.0",
  "description": "Libertad National High School STE Quizball — live quiz, house standings and weekly bulletin (React Native / Expo + Firebase).",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "build:web": "expo export -p web --output-dir /tmp/webbuild",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "verify": "npm run typecheck && npm test && npm run build:web && npm run smoke",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/im-fell-english": "^0.4.0",
    "@expo-google-fonts/marcellus": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "^57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3"
  }
}
