# ─────────────────────────────────────────────────────────────────────────────
#  Firebase configuration for the STE Quizball app.
#  Copy this file to `.env` and fill in the values from
#  Firebase console → Project settings → Your apps → SDK setup and options.
#
#  These are PUBLIC client keys (they ship inside the app bundle, exactly like
#  every Firebase mobile SDK). Security comes from Realtime Database rules,
#  Firestore rules and the Cloud Function — never from hiding these values.
#
#  Leave this file unset to run the app in its fully offline classroom mode.
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Optional tuning ─────────────────────────────────────────────────────────
# How a student's answer is scored.
#   cloud-function → callable `submitAnswer`; the correct answer never reaches
#                     the device (recommended for a real event)
#   transaction    → the Realtime Database transaction in services/quizSync.ts
#                     (deploy database.rules.labmode.json for this)
#   auto           → try the Cloud Function, fall back to the transaction
EXPO_PUBLIC_SUBMISSION_MODE=auto

# Root node for all Realtime Database data (must match database.rules.json).
EXPO_PUBLIC_RTDB_ROOT=ste_event

# Firestore collection that stores the weekly bulletin.
EXPO_PUBLIC_FIRESTORE_COLLECTION=bulletin_posts
